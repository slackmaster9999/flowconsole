{
  "name": "oss",
  "private": true,
  "scripts": {
    "build": "pnpm run build:workspace",
    "build:workspace": "pnpm -r build",
    "build:app": "pnpm --dir src/app build",
    "build:web": "pnpm --dir src/web build",
    "build:core": "pnpm --dir src/core build",
    "build:docs": "pnpm --dir src/docs build",
    "build:cli": "pnpm --dir src/cli build",
    "build:sdk": "pnpm --dir src/sdk build",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "pnpm --filter flowconsole test:unit",
    "test:e2e": "pnpm --filter flowconsole test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@xyflow/react": "^12.10.0",
    "react": "19.2.1",
    "vitest": "^4.0.15"
  }
}
