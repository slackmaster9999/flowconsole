{
  "name": "@flowconsole/core",
  "version": "0.0.1",
  "description": "FlowConsole core parser library for architecture-as-code",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./infra/*": {
      "types": "./dist/infra/*.d.ts",
      "require": "./dist/infra/*.js"
    },
    "./parsers/*": {
      "types": "./dist/parsers/*.d.ts",
      "require": "./dist/parsers/*.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "require": "./dist/types/*.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.tsbuildinfo",
    "!dist/vitest.config.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.19.0",
  "dependencies": {
    "@ast-grep/lang-csharp": "^0.0.5",
    "@ast-grep/lang-go": "^0.0.5",
    "@ast-grep/lang-java": "^0.0.6",
    "@ast-grep/lang-python": "^0.0.5",
    "@ast-grep/napi": "^0.40.5",
    "uuidv7": "^1.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "vitest": "^4.0.17",
    "@flowconsole/sdk": "workspace:*"
  }
}
